SELECT s.student_id, s.student_name, s.student_email, s.student_phone_number, c.course_id, c.course_name, c.instructor_name, c.instructor_email, scm.enrollment_date, scm.grade
FROM student AS s
JOIN student_email AS se
ON (s.student_id = se.student_id)

JOIN student_phone_number AS sp
ON (se.student_id = sp.student_id)

JOIN student_course_mapped AS scm
ON (sp.student_id = scm.student_id)

JOIN course AS c
ON (scm.course_id = c.course_id);
